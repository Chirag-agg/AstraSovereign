# Copy this file to `.env.local` and adjust the values. Never commit `.env.local`.
#
# Base URL of the local backend. Defaults to http://localhost:8000 when unset.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Demo mode: mirrors the backend's DEMO_MODE. With both set, the backend asks for
# no session and this app skips its sign-in screen instead of showing a login
# that authenticates nothing. Leave it out (or false) for the normal flow.
NEXT_PUBLIC_DEMO_MODE=false
