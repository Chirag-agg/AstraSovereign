# Copy this file to `.env` and adjust the values. Never commit `.env`.
#
# The backend talks ONLY to this local Ollama endpoint. It must stay on
# localhost / your private network for the air-gapped requirement.
OLLAMA_BASE_URL=http://localhost:11434

# Name of a model already pulled into your local Ollama (e.g. `ollama pull llama3.2`).
DEFAULT_MODEL=llama3.2

# Bind address/port for the FastAPI server (localhost only).
HOST=127.0.0.1
PORT=8000

# Per-request timeout for calls to Ollama (seconds).
OLLAMA_TIMEOUT_SECONDS=120

# Path to the task-type -> model mapping (see ../config/models.yaml).
MODELS_CONFIG=../config/models.yaml

# Agent loop limits (bounded, deterministic termination).
MAX_AGENT_ITERATIONS=10
MAX_AGENT_TOOL_CALLS=20

# Per-job workspace root (created automatically).
WORKSPACES_ROOT=../data/workspaces

# Docker code-execution sandbox (Phase 5). The image must already exist locally.
SANDBOX_ENABLED=true
SANDBOX_PYTHON_IMAGE=python:3.12-alpine
SANDBOX_TIMEOUT_SECONDS=10
SANDBOX_CPU_LIMIT=0.5
SANDBOX_MEMORY_LIMIT=128m
SANDBOX_MAX_STDOUT_CHARS=4096
SANDBOX_MAX_STDERR_CHARS=4096

# Resource scheduler capacity (Phase 6). Mode "configured" uses the values below;
# "auto" discovers local CPU/memory/GPU (informational, no NVIDIA tooling needed).
RESOURCE_CAPACITY_MODE=configured
RESOURCE_CPU_CORES=8
RESOURCE_MEMORY_MB=16384
RESOURCE_GPU_VRAM_MB=16384
RESOURCE_GPU_COUNT=1

# Local document knowledge base (Phase 7). All storage stays local, per user.
KNOWLEDGE_BASE_ROOT=../data/knowledge
UPLOADS_ROOT=../data/uploads
CHUNK_SIZE=800
CHUNK_OVERLAP=100
EMBEDDING_MODEL=nomic-embed-text
DOCUMENT_SEARCH_DEFAULT_TOP_K=5
DOCUMENT_SEARCH_MAX_TOP_K=10
DOCUMENT_SEARCH_MAX_CHUNK_CHARS=1000

# Multimodal OCR + vision (Phase 8). Fully local: RapidOCR (ONNX) + PDF page
# rendering (pypdfium2) + the registry-configured local vision model (llava:7b).
# The vision model must already be pulled into Ollama; nothing is auto-downloaded.
OCR_ENABLED=true
OCR_MAX_PAGES=50
OCR_MAX_IMAGE_DIMENSION=4000
OCR_RENDER_SCALE=2.0
VISION_MAX_PAGES=5
VISION_RESOURCE_WAIT_ROUNDS=5
MULTIMODAL_TMP_ROOT=../data/tmp

# Structured JSON logging.
LOG_LEVEL=INFO
LOG_FILE=../logs/backend.log

# Frontend cross-origin allow-list (comma-separated, local dev only).
CORS_ORIGINS=http://localhost:3000

# Local audit trail (Phase 11): append-only JSONL under this root.
AUDIT_ROOT=../data/audit

