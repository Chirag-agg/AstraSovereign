# Copy this file to `.env` and adjust the values. Never commit `.env`.
#
# The backend talks ONLY to this local Ollama endpoint. It must stay on
# localhost / your private network for the air-gapped requirement.
OLLAMA_BASE_URL=http://localhost:11434

# Name of a model already pulled into your local Ollama (e.g. `ollama pull gpt-oss:20b`).
# Used by the plain /api/chat path; the typed node pipeline routes per-task-type
# via config/models.yaml instead. Keep this in sync with the `general` entry
# there so a direct chat call and the pipeline agree on a default.
DEFAULT_MODEL=gpt-oss:20b

# Bind address/port for the FastAPI server (localhost only).
HOST=127.0.0.1
PORT=8000

# There is deliberately no Ollama request timeout: a local model on CPU can spend
# minutes on one tool-calling turn, and a deadline that fires mid-generation loses
# the whole job. A hung request therefore hangs the job rather than being killed —
# stop and restart the backend if a call never returns.

# Residency hint sent on every Ollama request ("5m" = Ollama's own default
# idle-unload). On a real capability switch between pipeline nodes, the model
# just released is additionally force-unloaded (see OLLAMA_UNLOAD_WAIT_SECONDS)
# instead of waiting out this timer, so VRAM is actually free before the next
# model's reservation is requested.
OLLAMA_KEEP_ALIVE=5m
# Bounded wait (seconds) for a forced unload to actually clear VRAM. Best-effort:
# never blocks a job past this deadline even if the unload isn't done in time.
OLLAMA_UNLOAD_WAIT_SECONDS=2.0

# Context window requested on every generation call. Ollama's own default (4096)
# is smaller than this app's system prompt plus one tool result, which is what
# produced intermittent HTTP 500s. A model whose KV cache is unusually cheap or
# expensive overrides this per model in config/models.yaml (`num_ctx`).
OLLAMA_NUM_CTX=16384
# Default cap on generated tokens, kept under the window so a reasoning model
# cannot spend the whole budget thinking and return nothing. Clamped per call
# against the room actually left in the window; OLLAMA_NUM_PREDICT_MIN is the
# floor that clamp never goes below.
OLLAMA_NUM_PREDICT=4096
OLLAMA_NUM_PREDICT_MIN=512
# Fraction of the window a prompt may occupy before the oldest tool results are
# trimmed. Ollama truncates an oversized prompt by silently dropping its middle;
# trimming ourselves is the same loss made visible and bounded.
OLLAMA_PROMPT_TRIM_RATIO=0.85
# How many times one job may trim and retry after an overflow it did not predict.
OLLAMA_MAX_OVERFLOW_RETRIES=3

# Which roster in ../config/models.yaml describes this machine (see `profiles`
# there). Empty means the file's `default_profile`.
MODEL_PROFILE=

# Path to the task-type -> model mapping (see ../config/models.yaml).
MODELS_CONFIG=../config/models.yaml

# Agent loop limits (bounded, deterministic termination).
MAX_AGENT_ITERATIONS=10
MAX_AGENT_TOOL_CALLS=20

# Per-job workspace root (created automatically).
WORKSPACES_ROOT=../data/workspaces

# Docker code-execution sandbox (Phase 5). The image must already exist locally.
SANDBOX_ENABLED=true
SANDBOX_PYTHON_IMAGE=python:3.12-alpine
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_CPU_LIMIT=0.5
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_MAX_STDOUT_CHARS=4096
SANDBOX_MAX_STDERR_CHARS=4096

# Sandbox auto-repair: on a failed run, ask the coding-capability model for a
# fix and re-run internally (inside one code_execution tool call, transparent
# to the agent's own iteration/tool-call budget). Bounded by both attempts and
# wall-clock time — a stuck repair loop must never eat the whole job budget.
SANDBOX_REPAIR_ENABLED=true
SANDBOX_REPAIR_MAX_ATTEMPTS=2
SANDBOX_REPAIR_DEADLINE_SECONDS=90.0

# Resource scheduler capacity (Phase 6). Mode "configured" uses the values below;
# "auto" discovers local CPU/memory/GPU (informational, no NVIDIA tooling needed).
# These are the real machine's numbers and must be measured, not assumed: the
# scheduler rejects any model declaring more than the capacity here, and each
# model's `resources` in ../config/models.yaml must fit them. A laptop RTX 3050
# has 6144 MiB, not the 16384 an optimistic default would suggest.
RESOURCE_CAPACITY_MODE=configured
RESOURCE_CPU_CORES=8
RESOURCE_MEMORY_MB=16384
RESOURCE_GPU_VRAM_MB=6144
RESOURCE_GPU_COUNT=1

# Local document knowledge base (Phase 7). All storage stays local, per user.
KNOWLEDGE_BASE_ROOT=../data/knowledge
UPLOADS_ROOT=../data/uploads
CHUNK_SIZE=800
CHUNK_OVERLAP=100
EMBEDDING_MODEL=nomic-embed-text
DOCUMENT_SEARCH_DEFAULT_TOP_K=5
DOCUMENT_SEARCH_MIN_TOP_K=3
DOCUMENT_SEARCH_MAX_TOP_K=10
DOCUMENT_SEARCH_MAX_CHUNK_CHARS=1000

# Multimodal OCR + vision (Phase 8). Fully local: RapidOCR (ONNX) + PDF page
# rendering (pypdfium2) + the registry-configured local vision model
# (qwen3-vl:latest, the `vision` entry in config/models.yaml).
# The vision model must already be pulled into Ollama; nothing is auto-downloaded.
OCR_ENABLED=true
OCR_MAX_PAGES=50
OCR_MAX_IMAGE_DIMENSION=4000
OCR_RENDER_SCALE=2.0
VISION_MAX_PAGES=5
VISION_RESOURCE_WAIT_ROUNDS=5
MULTIMODAL_TMP_ROOT=../data/tmp

# Structured JSON logging.
LOG_LEVEL=INFO
LOG_FILE=../logs/backend.log

# Frontend cross-origin allow-list (comma-separated, local dev only).
CORS_ORIGINS=http://localhost:3000

# Local audit trail (Phase 11): append-only JSONL under this root.
AUDIT_ROOT=../data/audit


# Durable SQLite store (jobs, artifact metadata, hash-chained audit, users).
DATABASE_PATH=../data/astra.db

# Real local authentication. Leave SESSION_SECRET unset to auto-generate and
# persist one at ../data/session_secret.key on first boot (so restarts don't
# invalidate every session); set it explicitly to pin the secret (e.g. across
# a reinstall). SESSION_COOKIE_SECURE should be true once TLS is terminated
# in front of the app; false is correct for a plain-HTTP local deployment.
# The first user account is auto-created on first boot (username "admin",
# a random password written once to ../data/bootstrap_admin_password.txt);
# create further accounts with backend/scripts/create_user.py.
SESSION_SECRET=
SESSION_TTL_SECONDS=43200
SESSION_COOKIE_SECURE=false

# Demonstration mode: authentication off. A request needs no session and no
# password; the caller is taken from the X-User-ID/X-Role header, defaulting to
# user-001. Anyone who can reach the port can act as any user, admin included.
# Local demo only — never set this on a reachable host.
DEMO_MODE=false

# Model fallback: follow each entry's declared `fallback_to` chain when the
# configured model is unavailable (never an arbitrary model). Disable for
# benchmarks so routing is measured without substitution.
MODEL_FALLBACK_ENABLED=true

# Job-plan filler: a ~1B model that fills only the fields the deterministic
# layer left unset (implicit requests). Off by default — enable it once
# bench/plan_eval.py shows it beats the deterministic-only baseline. The model
# must already be pulled into Ollama and is declared as the `planner` entry in
# ../config/models.yaml.
PLANNER_ENABLED=false
PLANNER_MODEL=qwen3:1.7b
